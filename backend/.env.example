# Copy this file to ".env" (in this same backend folder) and fill in real values.
# ".env" is listed in .gitignore, so your passwords never reach GitHub.

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lostfound
DB_USER=lostfound
DB_PASSWORD=change-me

# ---- Security ----
# A long random secret used to protect login codes and sessions.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never share it, and use a different one on the deployed server.
SECRET_KEY=change-me-to-a-long-random-string

# How long you stay signed in.
SESSION_DAYS=30
# true on the deployed (https) site; false on your computer (http).
COOKIE_SECURE=false
# Optional (defaults shown): cookie name and sign-in code limits.
# SESSION_COOKIE_NAME=lf_session
# LOGIN_CODE_MINUTES=10
# LOGIN_CODE_MAX_ATTEMPTS=5
# LOGIN_CODE_RESEND_SECONDS=60
# LOGIN_CODE_MAX_PER_HOUR=5

# ---- App ----
# Students must sign in with an email ending in this domain.
ALLOWED_EMAIL_DOMAIN=iitk.ac.in
# Guards and the admin may also use these domains (comma-separated), but only
# after the admin has added them as a guard (or make-admin was run).
STAFF_EMAIL_DOMAINS=gmail.com

# The address the Next.js frontend runs on, allowed to call this API.
FRONTEND_ORIGIN=http://localhost:3000
# Campus time zone, used for "today" and dates in emails (default shown).
# TIMEZONE=Asia/Kolkata

# ---- Item photos ----
# Where uploaded photos are saved (default: backend/uploads).
# UPLOAD_DIR=
MAX_PHOTOS_PER_ITEM=3
MAX_PHOTO_MB=5

# ---- Email ----
# "console": print emails in the terminal (for development, no setup needed);
#            the designed HTML version is saved in backend/.cache/emails/.
# "smtp":    really send them, using the SMTP settings below.
# Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account > Security > App passwords) and put it in SMTP_PASSWORD.
# Your normal Gmail password does NOT work here. Never commit the real one.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional; empty = "TraceBack <SMTP_USER>".
EMAIL_FROM=
# (Links in emails use FRONTEND_ORIGIN above.)

# ---- AI (see docs/AI.md) ----
# semantic = AI matching on ("Possible matches" on reports). placeholder = off.
MATCHING_BACKEND=semantic
# Suggestions per report.
MATCH_TOP_K=5
# local = small open-source model, downloaded once (~70 MB). hashing = no download.
EMBEDDING_BACKEND=local

# When the AI agent re-ranks matches: off | ambiguous (only when the maths
# isn't sure, saves LLM calls) | always (every report, e.g. for a demo).
AGENT_MATCHING=ambiguous
# Gemini describes item photos (never ID cards or documents). true / false.
AI_PHOTO_DESCRIPTIONS=true
# Found ID cards: read the roll number / IITK email on the photo (offline OCR
# on this server) and email the owner once the card is at a security office.
ID_CARD_OCR=true

# Agent (Phase B): Groq is the main model, Gemini the fallback.
# Create free keys at https://console.groq.com and https://aistudio.google.com.
# Never commit real keys: this example file goes to GitHub, .env does not.
LLM_API_KEY=
GEMINI_API_KEY=
