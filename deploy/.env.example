# Production settings, used by docker-compose.yml.
# deploy.sh creates deploy/.env from this file on the server the first time,
# filling in SITE_ADDRESS, FRONTEND_ORIGIN, DB_PASSWORD and SECRET_KEY.
# Edit it on the server with:  nano ~/lost-found/deploy/.env
# Never commit the real deploy/.env.

# ---- Address ----
# Your domain, or <public-ip-with-dashes>.sslip.io if you have no domain
# (e.g. 13-233-45-67.sslip.io). Caddy gets the HTTPS certificate for it.
SITE_ADDRESS=__SITE__
FRONTEND_ORIGIN=https://__SITE__

# ---- Database (the PostgreSQL container uses these too) ----
DB_NAME=lostfound
DB_USER=lostfound
DB_PASSWORD=__DB_PASSWORD__

# ---- Security ----
SECRET_KEY=__SECRET_KEY__
SESSION_DAYS=30
COOKIE_SECURE=true

# ---- App ----
ALLOWED_EMAIL_DOMAIN=iitk.ac.in
STAFF_EMAIL_DOMAINS=gmail.com
TIMEZONE=Asia/Kolkata
MAX_PHOTOS_PER_ITEM=3
MAX_PHOTO_MB=5

# ---- Email ----
# console = sign-in codes only appear in the server logs
#   (sudo docker compose logs backend). Fine for a first test.
# smtp    = real emails. With Gmail, use an App Password (not your normal one).
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ---- AI (see backend/docs/AI.md) ----
MATCHING_BACKEND=semantic
MATCH_TOP_K=5
EMBEDDING_BACKEND=local
AGENT_MATCHING=ambiguous
AI_PHOTO_DESCRIPTIONS=true
ID_CARD_OCR=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
LLM_API_KEY=
